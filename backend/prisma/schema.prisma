generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id           Int       @id @default(autoincrement())
  countryCode  String?
  phoneNumber  String    @unique
  savedName    String?
  displayName  String?
  isAdmin      Boolean   @default(false)
  status       String    @default("PENDING") // PENDING, SENT, FAILED, SKIPPED
  waMessageId  String?
  sentAt       DateTime?
  errorMessage String?

  sendLogs     SendLog[]
}

model MessageTemplate {
  id                     Int       @id @default(autoincrement())
  name                   String    @unique
  content                String
  metaTemplateName       String?
  headerDocumentUrl      String?
  headerDocumentFilename String?

  sendLogs               SendLog[]
}

model SendLog {
  id              Int       @id @default(autoincrement())
  contactId       Int
  templateId      Int
  renderedMessage String
  waMessageId     String?
  sentAt          DateTime  @default(now())
  responseStatus  String?
  responseBody    String?

  contact         Contact         @relation(fields: [contactId], references: [id])
  template        MessageTemplate @relation(fields: [templateId], references: [id])
}

model AppSetting {
  key   String @id
  value String
}

model Pipeline {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  description  String?
  isActive     Boolean   @default(true)
  triggerType  String    // INTERVAL, DAILY_TIME
  intervalMins Int?      // e.g. 60
  dailyTime    String?   // e.g. "10:00"
  targetStatus String    @default("PENDING") // PENDING, FAILED, ALL
  templateId   Int
  batchSize    Int       @default(50)
  delayMs      Int       @default(2000)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  totalRuns    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
